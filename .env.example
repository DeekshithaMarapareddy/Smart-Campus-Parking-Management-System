# Copy this file to .env.local and edit the values.

# PostgreSQL connection string (user:password@host:port/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scpms

# MongoDB connection string. The app still works if MongoDB is down,
# but the activity and sensor logs will be empty.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=scpms_logs

# Long random string used to sign login cookies. Change it.
JWT_SECRET=change-this-to-a-long-random-string

# Time zone used by the database for "today", "past booking" checks etc.
APP_TIMEZONE=Asia/Kolkata
